{
  "schemaVersion": 1,
  "projects": [
    {
      "id": "justin",
      "name": "ESP32 Tinker",
      "description": "The original ESP32 Tinker multi-program firmware.",
      "path": "firmware/justin",
      "versionFile": "firmware/justin/VERSION",
      "buildable": true,
      "environments": {
        "production": "esp32dev",
        "wokwi": "wokwi"
      },
      "hardware": {
        "status": "configured",
        "profile": "max7219-4-fc16",
        "chipFamily": "ESP32"
      },
      "preBuild": [
        [
          "python3",
          "scripts/import-pixel-art.py"
        ]
      ],
      "dependencies": {
        "commands": [
          "python3"
        ],
        "pythonModules": [],
        "conditionalPythonModules": [
          {
            "module": "PIL",
            "whenPath": "firmware/justin/src/programs/pixel_art/assets"
          }
        ]
      },
      "docs": {
        "route": "/",
        "path": "docs",
        "manifest": "docs/manifest.json"
      },
      "artifacts": {
        "bootloader": {
          "source": "bootloader.bin",
          "offset": 4096
        },
        "partitions": {
          "source": "partitions.bin",
          "offset": 32768
        },
        "app": {
          "source": "firmware.bin",
          "offset": 65536,
          "publishedName": "firmware_{version}.bin"
        }
      }
    },
    {
