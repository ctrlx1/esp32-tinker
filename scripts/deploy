#!/usr/bin/env bash
# Bump, build, publish, commit, and tag one registered project.
# Add --push only when the release should be sent to the remote.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ "$#" -eq 0 || "${1:-}" == -* ]]; then
  echo "Usage: $0 <project> --major|--minor|--patch" >&2
  exit 2
fi

exec python3 "$ROOT/scripts/project_tool.py" deploy "$@"
