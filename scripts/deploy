#!/usr/bin/env bash
# Bump, build, publish, commit, and push one registered project.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ "$#" -eq 0 ]]; then
  echo "Usage: $0 <project> --major|--minor|--patch" >&2
  exit 2
fi

if [[ "${1:-}" == -* ]]; then
  echo "Compatibility mode: defaulting to project 'justin'." >&2
  set -- justin "$@"
fi

exec python3 "$ROOT/scripts/project_tool.py" deploy "$@"
